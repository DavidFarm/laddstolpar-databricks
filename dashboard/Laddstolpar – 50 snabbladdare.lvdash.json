{
  "datasets": [
    {
      "name": "449c67e5",
      "displayName": "ds_allocation",
      "queryLines": [
        "SELECT\r\n",
        "  a.n_p1, a.variant, a.is_default,\r\n",
        "  a.kommun_kod, k.kommun_namn, k.lan_namn, k.kommungrupp, k.is_besoksnaring, k.elomrade,\r\n",
        "  a.n_part1, a.n_part2, a.n_stations, a.kw_new,\r\n",
        "  a.kw_new / 1000.0 AS mw_new,\r\n",
        "  a.first_seat,\r\n",
        "  CASE\r\n",
        "    WHEN a.n_stations = 0 THEN 'Ingen'\r\n",
        "    WHEN a.n_part1 > 0 AND a.n_part2 > 0 THEN 'Båda'\r\n",
        "    WHEN a.n_part1 > 0 THEN 'P1 – där bilarna bor'\r\n",
        "    ELSE 'P2 – där bilarna kör'\r\n",
        "  END AS strategi\r\n",
        "FROM laddstolpar_df.gold.mart_allocation_combined a\r\n",
        "JOIN laddstolpar_df.gold.dim_kommun k USING (kommun_kod)\r\n",
        "ORDER BY a.n_p1, a.variant, a.n_stations DESC, a.first_seat"
      ]
    },
    {
      "name": "7720ccab",
      "displayName": "ds_component",
      "queryLines": [
        "-- ds_component: score components per strategy × shared variant × kommun\r\n",
        "SELECT\r\n",
        "  c.scenario,                                   -- P1 / P2\r\n",
        "  CASE c.scenario WHEN 'P1' THEN 'P1 – där bilarna bor'\r\n",
        "                  ELSE 'P2 – där bilarna kör' END AS strategi,\r\n",
        "  c.variant,\r\n",
        "  c.kommun_kod,\r\n",
        "  k.kommun_namn,\r\n",
        "  c.metric_used,\r\n",
        "  CASE c.metric_used\r\n",
        "    WHEN 'ev_demand'       THEN 'Många elbilar'\r\n",
        "    WHEN 'growth'          THEN 'Snabb tillväxt'\r\n",
        "    WHEN 'growth_raw'      THEN 'Snabb tillväxt (rå)'\r\n",
        "    WHEN 'growth_stock'    THEN 'Tillväxt i flottan'\r\n",
        "    WHEN 'price'           THEN 'Billig el'\r\n",
        "    WHEN 'price_zone_alt'  THEN 'Billig el (alt. zon)'\r\n",
        "    WHEN 'supply'          THEN 'Få laddare per elbil'\r\n",
        "    WHEN 'supply_county'   THEN 'Få laddare per elbil (län)'\r\n",
        "    WHEN 'supply_traffic'  THEN 'Få laddare per trafik'\r\n",
        "    WHEN 'through_traffic' THEN 'Genomfartstrafik'\r\n",
        "    ELSE c.metric_used\r\n",
        "  END AS komponent,\r\n",
        "  c.weight,\r\n",
        "  c.pct_rank,\r\n",
        "  c.contribution,\r\n",
        "  c.detail\r\n",
        "FROM laddstolpar_df.gold.mart_kommun_score_component c\r\n",
        "JOIN laddstolpar_df.gold.dim_kommun k USING (kommun_kod)\r\n",
        "WHERE c.variant IN (SELECT DISTINCT variant FROM laddstolpar_df.gold.mart_allocation_combined)"
      ]
    }
  ],
